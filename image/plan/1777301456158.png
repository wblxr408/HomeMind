### 3. DQN 适度增强（PyTorch + Double DQN）

 **文件** : `core/dqn/policy.py`

保留轻量级设计，但引入 PyTorch 和 Double DQN：

```python:core/dqn/policy.py
# 新增导入
import torch
import torch.nn as nn
import torch.optim as optim

# 扩展状态向量: 5维 -> 8维
# 新增: humidity, device_states_encoded
def _state_to_vector(self, context) -> np.ndarray:
    device_state_score = sum(
        1 for v in context.devices.values() if v == "开"
    ) / max(len(context.devices), 1)
    return np.array([
        context.hour / 23.0,
        (context.temperature - 15.0) / 20.0,
        context.members_home / 5.0,
        (context.last_scene + 1) / 8.0,  # 更新上限
        context.day_of_week / 6.0,
        context.humidity / 100.0,  # 新增
        device_state_score,         # 新增
    ], dtype=np.float32)

# 替换手动梯度为 PyTorch
class QNetwork(nn.Module):
    def __init__(self, state_dim=7, action_dim=9, hidden_dim=64):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(state_dim, hidden_dim),
            nn.Tanh(),
            nn.Linear(hidden_dim, hidden_dim),
            nn.Tanh(),
            nn.Linear(hidden_dim, action_dim),
        )

# Double DQN 更新逻辑
def _light_update(self):
    # Double DQN: 使用 online net 选动作，target net 算 Q 值
    with torch.no_grad():
        next_actions = self.online_net(next_states).argmax(1)
        next_q = self.target_net(next_states).gather(1, next_actions.unsqueeze(1)).squeeze()
    # ...
```

