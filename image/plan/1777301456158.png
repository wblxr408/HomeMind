### 5. 新增 NL→TAP 规则转换器

 **文件** : 新增 `core/automation/nl_to_tap.py`

利用现有 LLM 能力，将自然语言解析为 TAP 规则：

```python:core/automation/nl_to_tap.py
class NLToTAPConverter:
    """将自然语言转换为 TAP 规则"""
  
    # 节假日检测模式
    HOLIDAY_PATTERNS = [
        r"节假日", r"周末", r"周六", r"周日",
        r"元旦", r"春节", r"清明", r"五一", r"端午",
        r"中秋", r"国庆", r"圣诞",
    ]
  
    def __init__(self, llm_decider=None):
        self.llm = llm_decider
  
    def parse(self, nl_text: str) -> Optional[Dict]:
        """解析自然语言为 TAP 规则结构"""
        # 检测时间条件
        time_condition = self._extract_time_condition(nl_text)
        # 检测动作
        action = self._extract_action(nl_text)
        if not action:
            return None
        return {
            "trigger": time_condition,
            "action": action,
            "priority": 50,
        }
  
    def _extract_time_condition(self, text: str) -> Dict:
        """提取时间条件"""
        for pattern in self.HOLIDAY_PATTERNS:
            if re.search(pattern, text):
                if pattern in ["周六", "周日", "周末"]:
                    return {"type": "day_of_week", "days": [5, 6]}  # 0=Monday
                return {"type": "holiday", "pattern": pattern}
        # 尝试精确时间
        match = re.search(r"(\d{1,2}):(\d{2})", text)
        if match:
            return {"type": "time", "at": f"{match.group(1)}:{match.group(2)}"}
        return {"type": "time", "at": "08:00"}  # 默认早8点
  
    def _extract_action(self, text: str) -> Optional[Dict]:
        """提取动作（设备控制或场景切换）"""
        # 使用 LLM 或规则匹配
        # ...
```

