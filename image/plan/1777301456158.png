### 7. 场景 CRUD 持久化接口

当前场景定义硬编码在 `tools/scene_switch.py` 的 `SCENE_CONFIGS` 中，无法动态增删改。需要将场景配置持久化，并提供完整的 CRUD 接口。

#### 7.1 新增场景持久化存储（`core/automation/scene_store.py`）

```python:core/automation/scene_store.py
"""场景配置持久化存储"""
import json
import os
import uuid
from copy import deepcopy
from typing import Any, Dict, List, Optional

# 默认场景配置（冷启动用）
DEFAULT_SCENE_CONFIGS = {
    "睡眠模式": {
        "灯光": {"action": "adjust", "params": {"brightness": 10}},
        "空调": {"action": "adjust", "params": {"temperature": 26}},
        "电视": {"action": "off", "params": {}},
        "音响": {"action": "off", "params": {}},
    },
    "待客模式": {
        "灯光": {"action": "adjust", "params": {"brightness": 100}},
        "空调": {"action": "adjust", "params": {"temperature": 25}},
        "音响": {"action": "on", "params": {"volume": 30}},
    },
    # ... 其他默认场景
}

class SceneStore:
    """场景配置持久化存储，支持 CRUD 操作"""

    def __init__(self, path: str = "data/scenes.json"):
        self.path = path
        self.scenes: Dict[str, Dict] = {}
        self.load()

    def load(self) -> Dict[str, Dict]:
        if not os.path.exists(self.path):
            # 冷启动：使用默认场景
            self.scenes = deepcopy(DEFAULT_SCENE_CONFIGS)
            self.save()
            return self.scenes
        with open(self.path, "r", encoding="utf-8") as f:
            self.scenes = json.load(f)
        return self.scenes

    def save(self) -> bool:
        os.makedirs(os.path.dirname(self.path) or ".", exist_ok=True)
        with open(self.path, "w", encoding="utf-8") as f:
            json.dump(self.scenes, f, ensure_ascii=False, indent=2)
        return True

    def list_scenes(self) -> List[str]:
        return list(self.scenes.keys())

    def get_scene(self, name: str) -> Optional[Dict]:
        return deepcopy(self.scenes.get(name))

    def add_scene(self, name: str, config: Dict) -> Dict:
        self.scenes[name] = deepcopy(config)
        self.save()
        return self.get_scene(name)

    def update_scene(self, name: str, config: Dict) -> Optional[Dict]:
        if name not in self.scenes:
            return None
        self.scenes[name] = deepcopy(config)
        self.save()
        return self.get_scene(name)

    def delete_scene(self, name: str) -> bool:
        if name not in self.scenes:
            return False
        del self.scenes[name]
        self.save()
        return True
```

